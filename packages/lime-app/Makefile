include $(TOPDIR)/rules.mk

PKG_NAME:=lime-app
# Development mode - using local repository
PKG_VERSION:=dev-$(shell cd ../../repos/lime-app 2>/dev/null && git rev-parse --short HEAD || echo "local")
PKG_RELEASE:=2

# No download needed - using local sources


include $(INCLUDE_DIR)/package.mk

# Use local lime-app build directory
define Build/Prepare
	$(INSTALL_DIR) $(PKG_BUILD_DIR)
	# Copy the built assets from local lime-app repository
	$(CP) ../../repos/lime-app/build $(PKG_BUILD_DIR)/
endef

define Package/$(PKG_NAME)
	CATEGORY:=LibreMesh
	TITLE:=LimeApp
	MAINTAINER:=German Ferrero <germanferrero@altermundi.net>
	URL:=http://github.com/libremesh/lime-app
	DEPENDS:=+rpcd +uhttpd +uhttpd-mod-ubus +uhttpd-mod-lua \
		+ubus-lime-location +ubus-lime-metrics +ubus-lime-utils \
		+rpcd-mod-iwinfo +ubus-lime-groundrouting
	PKGARCH:=all
endef

define Package/$(PKG_NAME)/description
	Light webApp for LibreMesh over uhttpd
endef

define Build/Compile
endef

define Package/$(PKG_NAME)/install
	$(INSTALL_DIR) $(1)/
	$(CP) ./files/* $(1)/
	$(INSTALL_DIR) $(1)/www/app/
	$(CP) $(PKG_BUILD_DIR)/build/* $(1)/www/app/
endef

define Package/$(PKG_NAME)/postinst
#!/bin/sh
[ -n "$${IPKG_INSTROOT}" ] ||	( /etc/init.d/rpcd restart && /etc/init.d/uhttpd restart ) || true
endef

$(eval $(call BuildPackage,$(PKG_NAME)))
